  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#58594E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "comment.line.roxygen.r"
      ],
      "settings": {
        "foreground": "#58594E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class",
        "comment.block.documentation keyword",
        "punctuation.definition.tag.documentation",
        "keyword.other.documentation.roxygen.r"
      ],
      "settings": {
        "foreground": "#2B0062",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#136524",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.pipe.r",
        "keyword.operator.pipe",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#136524",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#4D4E45"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage"
      ],
      "settings": {
        "foreground": "#542500",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#542500",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.quoted",
        "string.template",
        "string",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#B71F30"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A03C05"
      }
    },
    {
