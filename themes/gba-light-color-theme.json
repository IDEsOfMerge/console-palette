  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#4F5A61",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "comment.line.roxygen.r"
      ],
      "settings": {
        "foreground": "#4F5A61",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class",
        "comment.block.documentation keyword",
        "punctuation.definition.tag.documentation",
        "keyword.other.documentation.roxygen.r"
      ],
      "settings": {
        "foreground": "#006C34",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#373DAD",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.pipe.r",
        "keyword.operator.pipe",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#373DAD",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#464E54"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage"
      ],
      "settings": {
        "foreground": "#002641",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#002641",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.quoted",
        "string.template",
        "string",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#B01C2E"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9D4000"
      }
