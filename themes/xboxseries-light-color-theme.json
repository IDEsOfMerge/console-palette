  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#525753",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "comment.line.roxygen.r"
      ],
      "settings": {
        "foreground": "#525753",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class",
        "comment.block.documentation keyword",
        "punctuation.definition.tag.documentation",
        "keyword.other.documentation.roxygen.r"
      ],
      "settings": {
        "foreground": "#373F9F",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#006A31",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.pipe.r",
        "keyword.operator.pipe",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#006A31",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#484B49"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage"
      ],
      "settings": {
        "foreground": "#00463F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00463F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.quoted",
        "string.template",
        "string",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#A1001D"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A73E05"
      }
    },
    {
