  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#92959A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "comment.line.roxygen.r"
      ],
      "settings": {
        "foreground": "#92959A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class",
        "comment.block.documentation keyword",
        "punctuation.definition.tag.documentation",
        "keyword.other.documentation.roxygen.r"
      ],
      "settings": {
        "foreground": "#AD9EFF",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#4FCB6A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.pipe.r",
        "keyword.operator.pipe",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#4FCB6A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#A0A1A5"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage"
      ],
      "settings": {
        "foreground": "#D88949",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D88949",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.quoted",
        "string.template",
        "string",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#FF2E30"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF8E61"
      }
