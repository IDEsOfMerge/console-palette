    "commands": [
      {
        "command": "consolePalette.toggleTheme",
        "title": "Console Palette: Toggle Theme"
      },
      {
        "command": "consolePalette.pickTheme",
        "title": "Console Palette: Pick Console Theme"
      },
      {
        "command": "consolePalette.randomTheme",
        "title": "Console Palette: Random Theme"
      },
      {
        "command": "consolePalette.openExplorer",
        "title": "Console Palette: Open Palette & Colorimetry Explorer"
      }
    ],
    "keybindings": [
      {
        "command": "consolePalette.toggleTheme",
        "key": "ctrl+k ctrl+g",
        "mac": "cmd+k cmd+g"
      }
    ],
    "walkthroughs": [
      {
        "id": "consolePalette.gettingStarted",
        "title": "Welcome to Console Palette",
        "description": "30 iconic gaming consoles · 60 scientifically tuned themes — a quick tour.",
        "steps": [
          {
            "id": "pickTheme",
            "title": "Pick your first console theme (with live preview)",
            "description": "Every iconic console from the 1977 Atari 2600 to the Steam Deck gets a Light and a Dark theme crafted in OKLCH from its authentic industrial design and display hardware. Arrow through the list to preview live before committing.\n[Pick a Console Theme](command:consolePalette.pickTheme)",
            "media": {
              "image": "icon.png",
              "altText": "Console Palette emblem"
            },
            "completionEvents": [
              "onCommand:consolePalette.pickTheme"
            ]
          },
          {
            "id": "toggle",
            "title": "Toggle Light and Dark",
            "description": "A smart, per-console toggle — flips between the Light and Dark variant of whichever console's theme is active. Bound to `ctrl+k ctrl+g` (`cmd+k cmd+g` on Mac), or run it from the Command Palette.\n[Toggle Theme](command:consolePalette.toggleTheme)",
            "media": {
              "markdown": "assets/walkthrough/toggle.md"
            },
            "completionEvents": [
              "onCommand:consolePalette.toggleTheme"
            ]
          },
          {
            "id": "story",
            "title": "Every pair tells a hardware story",
            "description": "PlayStation maps syntax roles to Triangle Emerald, Circle Coral, Cross Cobalt, and Square Rose anchored by the amber BIOS boot diamond. SNES blends North American lavender-violet with Super Famicom 4-color ABXY. Game Boy Dark honors the authentic 1989 DMG-01 4-shade olive LCD ramp, while Nintendo Switch sparks Neon Blue against Neon Red Joy-Cons.",
            "media": {
              "image": "icon.png",
              "altText": "Console Palette dual finish emblem"
            }
          },
          {
            "id": "colorScience",
            "title": "Launch the Interactive Palette & Colorimetry Explorer",
            "description": "Inspect OKLCH coordinates, WCAG 2.1 + APCA contrast, OKLab chromaticity polygons, and real-time protanopia/deuteranopia/tritanopia simulations across all 60 themes — and live-sync any theme straight into your editor.\n[Open Interactive Explorer](command:consolePalette.openExplorer)",
            "media": {
              "markdown": "assets/walkthrough/color-science.md"
            },
            "completionEvents": [
              "onCommand:consolePalette.openExplorer"
            ]
          }
        ]
      }
    ]
